# Copy to .env (git-ignored) and fill in. See docs/SUPABASE_SETUP.md.
# NEVER commit .env or paste these values into chats, issues or screenshots.

# Postgres connection string, "Session pooler" URI (includes your database password: SECRET)
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Project URL and anon key (public by design: read-only through row-level security)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
